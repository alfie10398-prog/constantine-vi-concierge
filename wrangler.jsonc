{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "constantine-vi-concierge",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "constantine-vi", "database_id": "REPLACE_AFTER_HOST_APPROVAL", "migrations_dir": "migrations"}]
}
